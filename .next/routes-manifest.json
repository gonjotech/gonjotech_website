{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 308,
      "regex": "^(?!/_next)/home(?:/)?$"
    },
    {
      "source": "/blogsc",
      "destination": "/blog",
      "statusCode": 308,
      "regex": "^(?!/_next)/blogsc(?:/)?$"
    },
    {
      "source": "/company",
      "destination": "/about",
      "statusCode": 308,
      "regex": "^(?!/_next)/company(?:/)?$"
    },
    {
      "source": "/privacy-policy",
