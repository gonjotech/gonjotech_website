2d:["$","div",null,{"className":"p-6 rounded-2xl bg-[#091122] border border-cyan-500/20 space-y-3","children":[["$","h2",null,{"className":"text-sm font-bold uppercase tracking-wider text-cyan-300 flex items-center gap-2","children":[["$","$La",null,{"ref":"$undefined","icon":{"name":"info","size":24,"node":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M12 16v-4","key":"1dtifu"}],["path",{"d":"M12 8h.01","key":"e9boi3"}]]},"className":"w-4 h-4 text-cyan-400"}],"Executive Summary & Overview"]}],["$","div",null,{"className":"space-y-3 text-slate-300 text-sm sm:text-base leading-relaxed","children":[["$","p","0",{"children":"In the face of overwhelming economic adversity, true human potential reveals itself through unyielding dedication and relentless focus."}],["$","p","1",{"children":"The extraordinary journey of Motin Mia—from an impoverished dye factory worker in Sylhet supporting a large family to leading Saif Sporting Club, winning silverware with Bashundhara Kings, and scoring unforgettable goals for the Bangladesh National Team—remains one of the most inspiring modern sports narratives in our nation's history."}],["$","p","2",{"children":"His story provides timeless lessons not only for aspiring athletes, but for software developers, entrepreneurs, and dreamers striving against the odds."}]]}]]}]
2e:["$","$L33",null,{"slot":"7244702911","className":"my-6"}]
2f:["$","article",null,{"className":"space-y-12","children":[["$","div","0",{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-white tracking-tight pt-4 border-t border-white/5","children":"1. The Crucible: A Humble Beginning in Sylhet"}],["$","div",null,{"className":"space-y-4 text-slate-300 text-base sm:text-lg leading-relaxed","children":[["$","p","0",{"className":"leading-relaxed","children":"Long before the roar of packed stadiums and international accolades, Motin Mia lived in the shadow of acute poverty in Sylhet, Bangladesh. Following the untimely demise of his father—the sole breadwinner of the household—the heavy financial burden of providing for a family of two brothers and four sisters fell squarely onto his young shoulders."}],["$","p","1",{"className":"leading-relaxed","children":"To keep food on the table, Motin worked as a laborer in a local cloth dyeing factory, earning a modest wage of 150 to 200 Bangladeshi Taka (approximately $2 to $3 USD) per day. His days were spent in exhausting physical toil amidst damp dye vats and fabric presses."}],["$","p","2",{"className":"leading-relaxed","children":"Yet, deep within him burned an unshakeable passion: football. Despite having no formal academy training, no professional football boots, and no coach to teach him tactical theory, Motin spent every spare minute after work practicing on rugged local village grounds."}]]}],"$undefined","$undefined","$undefined",false]}],["$","div","1",{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-white tracking-tight pt-4 border-t border-white/5","children":"2. The Turning Point: Opportunity Meets Relentless Preparation"}],["$","div",null,{"className":"space-y-4 text-slate-300 text-base sm:text-lg leading-relaxed","children":[["$","p","0",{"className":"leading-relaxed","children":"Fortune favors the prepared. When Motin's elder brother secured overseas employment in Dubai, the immediate survival crisis at home eased slightly, allowing Motin more hours to dedicate to the game he loved."}],["$","p","1",{"className":"leading-relaxed","children":"His natural flair, explosive acceleration, and sublime ball control soon caught the eye of Yeamin Munna, an established national footballer from Sylhet who was competing in the Bangladesh Premier League in Dhaka."}],["$","p","2",{"className":"leading-relaxed","children":"Recognizing his raw genius, Munna facilitated a trial for Motin with Saif Sporting Club—an ambitious new club competing in the Bangladesh Championship League with aspirations of earning promotion into the top-flight Premier League."}]]}],["$","ul",null,{"className":"space-y-3 bg-[#0c162e]/70 border border-white/5 rounded-2xl p-5 sm:p-6 my-4","children":[["$","li","0",{"className":"flex items-start gap-3 text-sm sm:text-base text-slate-300","children":[["$","$La",null,{"ref":"$undefined","icon":{"name":"circle-check","size":24,"node":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"m16 9-5.5 5.5L8 12","key":"xofnsj"}]],"aliases":["check-circle-2"]},"className":"w-4 h-4 text-cyan-400 mt-1 flex-shrink-0"}],["$","span",null,{"children":"Unstoppable Debut Season: Motin scored 5 crucial goals in 12 appearances for Saif Sporting Club."}]]}],["$","li","1",{"className":"flex items-start gap-3 text-sm sm:text-base text-slate-300","children":[["$","$La",null,{"ref":"$undefined","icon":"$2f:props:children:1:props:children:2:props:children:0:props:children:0:props:icon","className":"w-4 h-4 text-cyan-400 mt-1 flex-shrink-0"}],["$","span",null,{"children":"League Runners-Up: Helped propel Saif Sporting Club into the prestigious Bangladesh Premier League."}]]}],["$","li","2",{"className":"flex items-start gap-3 text-sm sm:text-base text-slate-300","children":[["$","$La",null,{"ref":"$undefined","icon":"$2f:props:children:1:props:children:2:props:children:0:props:children:0:props:icon","className":"w-4 h-4 tex