rty":"og:type","content":"article"}],["$","meta","16",{"property":"article:published_time","content":"March 2025 (Updated 2026)"}],["$","meta","17",{"property":"article:author","content":"GonjoTech Editorial Team"}],["$","meta","18",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","19",{"name":"twitter:title","content":"The Power of Grit and Perseverance: The Inspiring Story of Bangladeshi Footballer Motin Mia"}],["$","meta","20",{"name":"twitter:description","content":"From a humble dye worker in Sylhet earning 150 BDT a day to scoring sensational national team goals and winning championships: an enduring story of dedication, resilience, and triumph."}],["$","link","21",{"rel":"icon","href":"/favicon.ico?favicon.117ezoe8m31dk.ico","sizes":"48x48","type":"image/x-icon"}],["$","$L32","22",{}]]
