t-semibold uppercase tracking-wider block mb-1","children":["Mobile"," • ","10 min read"]}],["$","h4",null,{"className":"text-sm sm:text-base font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug","children":"How to Successfully Convert a Web Platform into a High-Performing Mobile App"}]]}]]}]]}]]}]
