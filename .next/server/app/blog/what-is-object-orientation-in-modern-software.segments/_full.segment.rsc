y":"og:type","content":"article"}],["$","meta","16",{"property":"article:published_time","content":"October 2024 (Updated 2026)"}],["$","meta","17",{"property":"article:author","content":"GonjoTech Engineering Team"}],["$","meta","18",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","19",{"name":"twitter:title","content":"Understanding Object-Oriented Architecture & Clean Domain Modeling in Enterprise Software"}],["$","meta","20",{"name":"twitter:description","content":"A deep dive into why object-oriented design patterns, SOLID principles, and domain-driven design remain the cornerstone of maintainable enterprise platforms and scalable microservices."}],["$","link","21",{"rel":"icon","href":"/favicon.ico?favicon.117ezoe8m31dk.ico","sizes":"48x48","type":"image/x-icon"}],["$","$L32","22",{}]]
