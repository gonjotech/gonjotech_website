34:["$","p","2",{"className":"leading-relaxed","children":"2. Abstraction: Removing extraneous implementation complexity from consumer code. A consumer service requesting payment does not need to know whether the transaction is routed via SSLCommerz, bKash, or Stripe; it simply calls 'PaymentProvider.charge(amount)'."}]
35:["$","p","3",{"className":"leading-relaxed","children":"3. Inheritance: Reusing behavioral contracts and shared baseline logic across specialized sub-entities. However, modern engineering heavily favors compositional polymorphism over deep inheritance hierarchies to avoid fragile base-class antipatterns."}]
36:["$","p","4",{"className":"leading-relaxed","children":"4. Polymorphism: The capacity of diverse objects to respond to the identical method invocation in specialized manners. Polymorphism allows enterprise microservices to introduce new payment processors or notification dispatchers without altering existing workflow pipelines."}]
37:["$","div",null,{"className":"p-5 rounded-2xl bg-gradient-to-r from-cyan-950/40 to-blue-950/30 border-l-4 border-cyan-400 text-sm sm:text-base text-cyan-200 my-6","children":"Architectural Rule: Prefer Composition over Inheritance. Favor composing small, focused interfaces rather than building 5-layer inheritance hierarchies that become impossible to refactor."}]
38:["$","$L33",null,{"slot":"7244702911","className":"my-8"}]
3d:T42d,// 1. Decoupled Abstraction (DIP)
export interface InvoiceNotificationService {
  sendInvoiceNotice(recipient: string, invoiceId: string): Promise<void>;
}

// 2. Concrete Implementations
export class EmailNotificationService implements InvoiceNotificationService {
  async sendInvoiceNotice(recipient: string, invoiceId: string): Promise<void> {
    console.log(`Sending transactional email to ${recipient} for invoice #${invoiceId}`);
  }
}

export class SmsNotificationService implements InvoiceNotificationService {
  async sendInvoiceNotice(recipient: string, invoiceId: string): Promise<void> {
    console.log(`Sending SMS notification to ${recipient} for invoice #${invoiceId}`);
  }
}

// 3. High-Level Domain Coordinator (Decoupled from concrete adapters)
export class InvoiceProcessor {
  constructor(private notifier: InvoiceNotificationService) {}

  public async completeOrder(customerPhone: string, invoiceId: string): Promise<void> {
    // Process internal accounting ledger...
    await this.notifier.sendInvoiceNotice(customerPhone, invoiceId);
  }
}39:["$","div","2",{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-white tracking-tight pt-4 border-t border-white/5","children":"3. Applying SOLID Principles with Modern TypeScript"}],["$","div",null,{"className":"space-y-4 text-slate-300 text-base sm:text-lg leading-relaxed","children":[["$","p","0",{"className":"leading-relaxed","children":"The SOLID principles—formulated by Robert C. Martin—elevate basic OOP into enterprise-grade clean architecture. Below is how the Dependency Inversion Principle (DIP) and Single Responsibility Principle (SRP) are practically implemented in modern enterprise TypeScript:"}]]}],"$undefined",["$","div",null,{"className":"rounded-2xl overflow-hidden border border-white/10 bg-[#060a12] my-6","children":[["$","div",null,{"className":"px-4 py-2.5 bg-white/5 border-b border-white/10 flex items-center justify-between text-xs font-mono text-slate-400","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","$La",null,{"ref":"$undefined","icon":{"name":"code","size":24,"node":[["path",{"d":"m16 18 6-6-6-6","key":"eg8j8"}],["path",{"d":"m8 6-6 6 6 6","key":"ppft3o"}]]},"className":"w-3.5 h-3.5 text-cyan-400"}],["$","span",null,{"className":"uppercase","children":"typescript"}]]}],["$","span",null,{"className":"text-[11px] text-slate-500","children":"Production Pattern"}]]}],["$","pre",null,{"className":"p-4 sm:p-6 text-xs sm:text-sm font-mono text-cyan-200/90 overflow-x-auto leading-relaxed","children":["$","code",null,{"children":"$3d"}]}]]}],"$undefined",false]}]
3a:["$","div","3",{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-white tracking-tight pt-4 border-t border-white/5","children":"4. Domain-Driven Design (DDD): Aligning OOP with Enterprise Strategy"}],["$","div",null,{"className":"space-y-4 text-slate-300 text-base sm:text-lg leading-relaxed","children":[["$","p","0",{"className":"leading-relaxed","children":"At GonjoTech, our enterprise deployments—such as GonjoERP and Swift Courier—leverage Domain-Driven Design (DDD). DDD organizes OOP code around distinct Domain Entities, Value Objects, and Aggregate Roots."}],["$","p","1",{"className":"leading-relaxed","children":"Entities have a distinct lifecycle identity (e.g., an Order with unique UUID #ORD-9821), while Value Objects are immutable descriptors defined solely by their properties (e.g., Money with currency 'BDT' and value 5000). By enforcing immutability in Value Objects, we eliminate race conditions in multi-threaded transaction pipelines."}],["$","p","2",{"className":"leading-relaxed","children":"Furthermore, Repositories decouple the persistence layer (PostgreSQL, MongoDB) from the core business logic. Whether we swap the database engine or execute tests against an in-memory mock, the business entity logic remains 100% unaffected."}]]}],["$","ul",null,{"className":"space-y-3 bg-[#0c162e]/70 border border-white/5 rounded-2xl p-5 sm:p-6 my-4","children":[["$","li","0",{"className":"flex items-start gap-3 text-sm sm:text-base text-slate-300","children":[["$","$La",null,{"ref":"$undefined","icon":"$2f:props:children:0:props:children:2:props:children:0:props:children:0:props:icon","className":"w-4 h-4 text-cyan-400 mt-1 flex-shrink-0"}],["$","span",null,{"children":"Aggregate Roots: Guarantee consistency boundaries across multiple related entities."}]]}],["$","li","1",{"className":"flex items-start gap-3 text-sm sm:text-base text-slate-300","children":[["$","$La",null,{"ref":"$undefined","icon":"$2f:props:children:0:props:children:2:props:children:0:props:children:0:props:icon","className":"w-4 h-4 text-cyan-400 mt-1 flex-shrink-0"}],["$","span",null,{"children":"Domain Events: Allow decoupled microservices to react asynchronously to business state transitions."}]]}],["$","li","2",{"className":"flex items-start gap-3 text-sm sm:text-base text-slate-300","children":[["$","$La",null,{"ref":"$undefined","icon":"$2f:props:children:0:props:children:2:props:children:0:props:children:0:props:icon","className":"w-4 h-4 text-cyan-400 mt-1 flex-shrink-0"}],["$","span",null,{"children":"Anti-Corruption Layers: Shield internal enterprise models from brittle third-party API contracts."}]]}]]}],"$undefined","$undefined",false]}]
3b:["$","div","4",{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-white tracking-tight pt-4 border-t border-white/5","children":"5. Common OOP Antipatterns and How to Avoid Them"}],["$","div",null,{"className":"space-y-4 text-slate-300 text-base sm:text-lg leading-relaxed","children":[["$","p","0",{"className":"leading-relaxed","children":"Even experienced teams can fall into architectural traps that degrade OOP code quality. The three most prevalent are:"}],["$","p","1",{"className":"leading-relaxed","children":"The 'God Object': A monolithic class (such as 'SystemManager' or 'AppController') that accumulates thousands of lines and controls dozens of unrelated responsibilities. Solution: Decompose into single-purpose command handlers and domain services."}],["$","p","2",{"className":"leading-relaxed","children":"Anemic Domain Model: Classes that contain only getters and setters with zero behavioral logic, leaving business rules scattered across disconnected utility functions. Solution: Move entity validation and business operations directly into the domain object itself."}],["$","p","3",{"className":"leading-relaxed","children":"Tight Coupling: Direct instantiation of dependencies using 'new' within constructors, preventing test mocking and flexibility. Solution: Utilize dependency injection containers or inversion-of-control factories."}]]}],"$undefined","$undefined","$undefined",false]}]
3c:["$","div","5",{"className":"space-y-6","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-extrabold text-white tracking-tight pt-4 border-t border-white/5","children":"6. Strategic Conclusion for Enterprise Engineering Teams"}],["$","div",null,{"className":"space-y-4 text-slate-300 text-base sm:text-lg leading-relaxed","children":[["$","p","0",{"className":"leading-relaxed","children":"Object-oriented architecture is far from an obsolete academic dogma. In 2026 and beyond, as enterprise software systems grow more complex and integrate with distributed microservices and AI-driven workflows, the principles of disciplined encapsulation, polymorphism, and domain modeling remain our most reliable defenses against technical debt."}],["$","p","1",{"className":"leading-relaxed","children":"By combining clean OOP with domain-driven boundaries and modern TypeScript or Java Spring Boot tooling, software development teams build digital platforms that scale gracefully alongside corporate growth."}]]}],"$undefined","$undefined","$undefined",false]}]
